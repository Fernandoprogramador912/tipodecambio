# Requerido para cotizaciÃ³n USD y proyecciÃ³n
ENABLE_FUTURES=true

# EUR/ARS venta en tarjeta = TC mayorista Ãÿ EUR/USD (FX) + este ajuste en pesos (default 2)
# EUR_VENTA_ADJUST_ARS=2

# Cruces internacionales (EUR/USD, USD/BRL, etc.): Yahoo Finance en vivo (sin key).
# Si Yahoo falla, fallback automÃ¡tico a Frankfurter (BCE, referencia diaria).

# Supabase (proyecciones diarias persistentes)
# SUPABASE_URL=https://tu-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DAILY_PROJECTIONS_TABLE=daily_projections
